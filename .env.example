# ════════════════════════════════════════════════════════════════════
#  Dripping Honey Treats: all environment variables (both apps)
#
#  LOCAL:   copy this file to `.env` in the repo root and fill it in.
#           Both apps (customer :3000, admin :3001) read the root .env.
#           NOTE: apps/*/.env.local override this file. Delete them if
#           they still point NEXT_PUBLIC_API_URL at localhost:4000.
#  NETLIFY: paste the same values into each site's
#           Site settings → Environment variables (see which site below).
#
#  Never commit .env. Anything WITHOUT the NEXT_PUBLIC_ prefix stays
#  on the server and is never shown to browsers.
#  Setup guide: docs/temp-backend.md
# ════════════════════════════════════════════════════════════════════


# ─── Both sites (public) ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Dripping Honey Treats
# Business WhatsApp shown to customers ("Chat with us"): digits only, country code first
NEXT_PUBLIC_WHATSAPP=2348000000000
# Temp backend lives in the customer app. Later: the real API URL.
NEXT_PUBLIC_API_URL=/api/v1


# ─── ADMIN site only ─────────────────────────────────────────────────
# Customer site origin, no trailing slash. Admin proxies /api/v1 to it.
TEMP_API_ORIGIN=http://localhost:3000


# ─── CUSTOMER site only (server secrets) ─────────────────────────────

# Public URLs: exact, no trailing slash.
# Local: http://localhost:3000 / :3001 · Live: https://www.drippinghoneytreats.com / https://admin.drippinghoneytreats.com
APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# Signs login cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# Supabase → Project settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Staff
# These emails become SUPER_ADMIN on first admin sign-in (comma-separated)
ADMIN_EMAILS=hello@drippinghoneytreats.com
# New-order / new-event alerts
ADMIN_NOTIFY_EMAILS=hello@drippinghoneytreats.com
ADMIN_NOTIFY_WHATSAPP=+2348000000000

# Images: Cloudinary (recommended). Leave empty to use Supabase Storage (1 GB free).
# cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dripping-honey-treats

# Email: sends as hello@drippinghoneytreats.com (mailbox hosted on Zoho). Pick ONE:
# Option A (recommended): Resend. Free 3,000/month, works on any Zoho plan.
#   resend.com → Domains → add drippinghoneytreats.com → copy the DNS records into Netlify DNS.
RESEND_API_KEY=
# Option B: Zoho SMTP. Paid Zoho plans only (the free plan has no SMTP).
#   Zoho → My Account → Security → App Passwords. Set SMTP_HOST to enable; leave it EMPTY to use Resend.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=hello@drippinghoneytreats.com
SMTP_PASS=
EMAIL_FROM=Dripping Honey Treats <hello@drippinghoneytreats.com>
EMAIL_REPLY_TO=hello@drippinghoneytreats.com
# Optional: logo shown at the top of emails (any public https URL, e.g. upload logo.png to Cloudinary).
# Default: {APP_URL}/assets/logo/logo.png (only works once the site is live).
EMAIL_LOGO_URL=

# WhatsApp Cloud API: developers.facebook.com → your app → WhatsApp → API setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
# Approved template names. Leave empty until Meta approves them (then plain text is sent: testing only).
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_UPDATE=
WHATSAPP_TEMPLATE_ADMIN=

# Google sign-in: console.cloud.google.com → Credentials → OAuth client (Web)
# Redirect URI: {APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments: flutterwave | paystack | kora
PAYMENT_PROVIDER=flutterwave
FLW_SECRET_KEY=
# Any long random string. Paste the same value in Flutterwave → Settings → Webhooks → Secret hash
FLW_SECRET_HASH=
PAYSTACK_SECRET_KEY=
KORA_SECRET_KEY=
# Gateways require an email; used for phone-only customers
PAYMENT_FALLBACK_EMAIL_DOMAIN=drippinghoneytreats.com

# Local dev only: this code always signs you in. NEVER set on Netlify.
DEV_OTP_CODE=123456
